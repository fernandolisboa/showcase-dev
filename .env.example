# Control-plane configuration (see internal/config/config.go).
# Copy to .env for local use. In production these come from Azure Key Vault
# (ADR-0009); a demo never receives platform secrets (ADR-0003).
HOST=
PORT=8080
ENV=dev

# Local Postgres from compose.dev.yml (write model lands in a later slice):
DATABASE_URL=postgres://showcase:showcase@localhost:5432/showcase?sslmode=disable

# Traefik-facing internal listeners (ADR-0004). INTERNAL_HOST defaults to
# 127.0.0.1 so the control-plane surface is never on a Session-reachable interface;
# the dev Traefik container reaches the host over the bridge gateway, so dev sets
# INTERNAL_HOST=0.0.0.0. INTERNAL_PORT serves /traefik (the backend map, Traefik
# polls it); SPLASH_PORT serves the booting page only (no /traefik) — a booting
# Session is routed here, so the two must stay separate.
INTERNAL_HOST=0.0.0.0
INTERNAL_PORT=8081
SPLASH_PORT=8082
