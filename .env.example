# Control-plane configuration (see internal/config/config.go).
# Copy to .env for local use. In production these come from Azure Key Vault
# (ADR-0009); a demo never receives platform secrets (ADR-0003).
HOST=
PORT=8080
ENV=dev

# Local Postgres from compose.dev.yml (write model lands in a later slice):
DATABASE_URL=postgres://showcase:showcase@localhost:5432/showcase?sslmode=disable
